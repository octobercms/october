{
  "name": "October CMS",
  "image": "ghcr.io/octobercms/runtime-dev:latest",
  "workspaceFolder": "/var/www/html",
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "October CMS",
      "onAutoForward": "openPreview",
      "protocol": "https"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "php-fpm -D && nginx"
}
